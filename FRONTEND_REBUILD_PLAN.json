  "filesToUpdate": [
    {
      "path": "compose.yaml",
      "changes": [
        "Add new 'web-server' service",
        "Configure volume mounts for web/ directory",
        "Set up port mapping (e.g., 8080:3000)",
        "Add dependency on apache service for API proxying"
      ],
      "description": "Add web-server service to docker-compose configuration"
    },
    {
      "path": ".gitignore",
      "changes": [
        "Add web-server/node_modules",
        "Add web-server/.env"
      ],
      "description": "Ignore web-server dependencies and environment files"
    }
  ],
  "dockerConfiguration": {
    "newService": "web-server",
    "baseImage": "node:18-alpine",
    "ports": ["8080:3000"],
    "volumes": [
      "./web:/app/web:ro",
      "./web-server:/app/server"
    ],
    "environment": [
      "NODE_ENV=development",
      "API_BASE_URL=http://apache:80"
    ],
    "command": "npm run dev",
    "dependencies": ["apache"]
  },
  "implementationPhases": [
    {
      "phase": 1,
      "name": "Core Infrastructure Setup",
      "tasks": [
        "Create directory structure",
        "Set up web-server with Express",
        "Configure Docker and compose.yaml",
        "Create base HTML and app.js"
      ]
    },
    {
      "phase": 2,
      "name": "Core Classes Implementation",
      "tasks": [
        "Implement Component base class",
        "Implement Page base class",
        "Implement Router",
        "Implement Store and EventBus",
        "Implement APIService"
      ]
    },
    {
      "phase": 3,
      "name": "CSS Architecture",
      "tasks": [
        "Create CSS variables and design tokens",
        "Implement reset and base styles",
        "Create component styles",
        "Create page-specific styles"
      ]
    },
    {
      "phase": 4,
      "name": "Services Layer",
      "tasks": [
        "Implement AuthService with Google OAuth",
        "Implement WebSocketService",
        "Create utility modules"
      ]
    },
    {
      "phase": 5,
      "name": "Components and Pages",
      "tasks": [
        "Create shared components (Header, Dialog, Cards)",
        "Implement HomePage",
        "Implement EditorPage",
        "Implement ProfilePage",
        "Implement TournamentPage"
      ]
    },
    {
      "phase": 6,
      "name": "Migration and Testing",
      "tasks": [
        "Test all routes and pages",
        "Verify API integration",
        "Test WebSocket connections",
        "Update documentation",
        "Create migration guide"
      ]
    }
  ],
  "constraints": [
    "Use only vanilla JavaScript (ES2025), no frameworks",
    "PHP backend remains unchanged except for CORS headers if needed",
    "Support same browsers as current version (modern evergreen browsers)",
    "Maintain all existing functionality",
    "No breaking changes to API contracts"
  ],
  "successCriteria": [
    "All pages accessible via new front-end",
    "Google OAuth login working",
    "WebSocket real-time updates functioning",
    "API calls successfully proxied to PHP backend",
    "Modern CSS features working in supported browsers",
    "Docker containers running without errors",
    "Performance equal or better than current implementation"
  ],
  "notes": [
    "This is a complete front-end rewrite while keeping PHP backend intact",
    "The old public_html/ structure will remain for API endpoints",
    "New web/ directory will contain the modern front-end",
    "Express server proxies API calls to PHP backend on Apache",
    "Migration will be incremental - both old and new can coexist during transition",
    "Consider feature flags for gradual rollout"
  ]
}
