{
  "projectName": "gladCode2 Front-End Rebuild",
  "description": "Rebuild front-end into modern, modular, vanilla-JS (ES2025) class-based OOP codebase served from Node.js static server",
  "objectives": [
    "Create modern vanilla JavaScript architecture with ES2025 features",
    "Implement class-based OOP design patterns",
    "Use modern CSS with custom properties, color-mix(), and nesting",
    "Set up Node.js Express server for static files and API proxying",
    "Containerize with Docker",
    "Maintain PHP backend for API endpoints"
