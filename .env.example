NODE_ENV=production
MYSQL_DATABASE=DATABASE_NAME
MYSQL_ROOT_PASSWORD=DATABASE_PASSWORD
MYSQL_PORT=3306
APACHE_PORT=80
RUNNER_PORT=3000
# Feature gate: expose the Three.js Coliseu 3D renderer as an option in playback.
# 1/true/on/yes to show, anything else hides it (classic 2D only).
ENABLE_RENDER2=1
# Optional: override private config/config.json without editing the file.
# Apache (compose.yaml) and node/server.js read these first when set.
#MYSQL_HOST=mysql
#MYSQL_USER=root
MAILER_HOST=email-smtp.us-east-1.amazonaws.com
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=
# Node services (api/ and web/). WEB_URL/API_URL hold the base host only; the external
# ports live in WEB_PORT/API_PORT. Production: WEB_URL=https://gladcode.dev, WEB_PORT=443,
# API_URL=https://api.gladcode.dev, API_PORT=443.
WEB_URL=http://localhost
WEB_PORT=80
API_URL=http://localhost
API_PORT=3001
# At least 32 random characters in production (openssl rand -hex 32).
JWT_SECRET=
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=1036458629781-8j247asma3gm7u956gbn3d0m0nobqhie.apps.googleusercontent.com
# Comma-separated emails allowed into the admin tools and release page.
ADMIN_EMAILS=
# Set to true only behind a trusted reverse proxy.
TRUST_PROXY=false
