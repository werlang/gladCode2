NODE_ENV=production
MYSQL_DATABASE=DATABASE_NAME
MYSQL_ROOT_PASSWORD=DATABASE_PASSWORD
MYSQL_PORT=3306
RUNNER_PORT=3000
# Feature gate: expose the Three.js Coliseu 3D renderer as an option in playback.
# 1/true/on/yes to show, anything else hides it (classic 2D only).
ENABLE_RENDER2=1
# 1/true/on/yes answers every page with the maintenance notice (files and the API keep working).
MAINTENANCE=
MAILER_HOST=email-smtp.us-east-1.amazonaws.com
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=
# Local development: run web and api from the source folders with live reload.
#COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Node services (api/ and web/). WEB_URL/API_URL hold the base host only; the ports in the public
# URLs live in WEB_PORT/API_PORT. Production: WEB_URL=https://gladcode.dev, WEB_PORT=443,
# API_URL=https://api.gladcode.dev, API_PORT=443.
WEB_URL=http://localhost
WEB_PORT=80
API_URL=http://localhost
API_PORT=3001
# Where the host publishes the containers: keep 127.0.0.1 so only nginx (or this machine) reaches
# them; a bare port listens on every interface, and Docker publishing skips host firewalls.
WEB_PUBLISH=127.0.0.1:80
API_PUBLISH=127.0.0.1:3001
# At least 32 random characters in production (openssl rand -hex 32).
JWT_SECRET=
SESSION_TTL_DAYS=30
GOOGLE_CLIENT_ID=108043684563-ufdkp1teq749udehcfjjtuk277q5h0me.apps.googleusercontent.com
# Comma-separated emails allowed into the admin tools and release page.
ADMIN_EMAILS=
# Set to true only behind a trusted reverse proxy (it gives the API the visitor's address).
TRUST_PROXY=false
# Battles the engine runs at once; the next ones wait.
RUNNER_CONCURRENCY=6
