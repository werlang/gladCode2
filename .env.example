NODE_ENV=production
MYSQL_DATABASE=DATABASE_NAME
MYSQL_ROOT_PASSWORD=DATABASE_PASSWORD
MYSQL_PORT=3306
APACHE_PORT=80
RUNNER_PORT=3000
# Feature gate: expose the Three.js Coliseu 3D renderer as an option in playback.
# 1/true/on/yes to show, anything else hides it (classic 2D only).
ENABLE_RENDER2=1
# Optional: override private config/config.json without editing the file.
# Apache (compose.yaml) and node/server.js read these first when set.
#MYSQL_HOST=mysql
#MYSQL_USER=root
MAILER_HOST=email-smtp.us-east-1.amazonaws.com
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=
